#
#   DbQuery.matches(doc, {"age": {"$gte": 21}, "role": {"$in": ["admin", "lead"]}})
#   DbQuery.applyChanges(doc, {"$inc": {"loginCount": 1}, "$set": {"active": true}})
#   DbQuery.aggregate(rows, {"groupBy": "role", "metrics": {"total": {"$count": "*"}, "avgAge": {"$avg": "age"}}})
#
# Exposes the global: DbQuery

class __QDbQuery {
    fn init() {}

    # â”€â”€ SQL LIKE pattern matcher (% = any sequence, _ = single char) â”€â”€â”€â”€â”€

    fn likeMatch(text, pattern, ignoreCase) {
        let s = DbUtil.text(text)
        let p = DbUtil.text(pattern)
        if ignoreCase == true {
            s = s.lower()
            p = p.lower()
        }
        return self.matchLikeAt(s, 0, p, 0)
    }

    fn matchLikeAt(s, si, p, pi) {
        let sLen = len(s)
        let pLen = len(p)
        while pi < pLen {
            let pc = p[pi]
            if pc == "%" {
                while pi < pLen and p[pi] == "%" { pi += 1 }
                if pi == pLen { return true }
                let k = si
                while k <= sLen {
                    if self.matchLikeAt(s, k, p, pi) { return true }
                    k += 1
                }
                return false
            }
            if si >= sLen { return false }
            if pc != "_" and pc != s[si] { return false }
            si += 1
            pi += 1
        }
        return si == sLen
    }

    # â”€â”€ Filter / WHERE evaluation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn matches(doc, whereSpec) {
        if whereSpec == null { return true }
        if type(whereSpec) != "dict" { return true }
        if len(whereSpec.keys()) == 0 { return true }

        for key in whereSpec.keys() {
            let cond = whereSpec[key]
            if key == "$and" {
                if type(cond) != "array" { return false }
                for sub in cond {
                    if not self.matches(doc, sub) { return false }
                }
                continue
            }
            if key == "$or" {
                if type(cond) != "array" or len(cond) == 0 { return false }
                let anyHit = false
                for sub in cond {
                    if self.matches(doc, sub) {
                        anyHit = true
                        break
                    }
                }
                if not anyHit { return false }
                continue
            }
            if key == "$not" {
                if self.matches(doc, cond) { return false }
                continue
            }

            let exists = DbUtil.hasPath(doc, key)
            let actual = DbUtil.getPath(doc, key)
            if not self.matchesField(actual, exists, cond) {
                return false
            }
        }
        return true
    }

    fn isOperatorDict(d) {
        if type(d) != "dict" { return false }
        let keys = d.keys()
        if len(keys) == 0 { return false }
        for k in keys {
            if k.startsWith("$") { return true }
        }
        return false
    }

    fn matchesField(actual, exists, cond) {
        if not self.isOperatorDict(cond) {
            return DbUtil.equals(actual, cond)
        }

        for op in cond.keys() {
            let target = cond[op]
            if op == "$eq" {
                if not DbUtil.equals(actual, target) { return false }
            } else if op == "$ne" {
                if DbUtil.equals(actual, target) { return false }
            } else if op == "$gt" {
                if actual == null or DbUtil.compareValues(actual, target) <= 0 { return false }
            } else if op == "$gte" {
                if actual == null or DbUtil.compareValues(actual, target) < 0 { return false }
            } else if op == "$lt" {
                if actual == null or DbUtil.compareValues(actual, target) >= 0 { return false }
            } else if op == "$lte" {
                if actual == null or DbUtil.compareValues(actual, target) > 0 { return false }
            } else if op == "$between" {
                if type(target) != "array" or len(target) < 2 or actual == null { return false }
                if DbUtil.compareValues(actual, target[0]) < 0 or DbUtil.compareValues(actual, target[1]) > 0 {
                    return false
                }
            } else if op == "$in" {
                if type(target) != "array" { return false }
                let found = false
                for item in target {
                    if DbUtil.equals(actual, item) {
                        found = true
                        break
                    }
                }
                if not found { return false }
            } else if op == "$nin" {
                if type(target) != "array" { return false }
                for item in target {
                    if DbUtil.equals(actual, item) { return false }
                }
            } else if op == "$contains" {
                if type(actual) == "array" {
                    let found = false
                    for item in actual {
                        if DbUtil.equals(item, target) {
                            found = true
                            break
                        }
                    }
                    if not found { return false }
                } else {
                    if not DbUtil.text(actual).contains(DbUtil.text(target)) { return false }
                }
            } else if op == "$icontains" {
                if not DbUtil.text(actual).lower().contains(DbUtil.text(target).lower()) { return false }
            } else if op == "$startsWith" {
                if not DbUtil.text(actual).startsWith(DbUtil.text(target)) { return false }
            } else if op == "$endsWith" {
                if not DbUtil.text(actual).endsWith(DbUtil.text(target)) { return false }
            } else if op == "$like" {
                if not self.likeMatch(actual, target, false) { return false }
            } else if op == "$ilike" {
                if not self.likeMatch(actual, target, true) { return false }
            } else if op == "$all" {
                if type(actual) != "array" or type(target) != "array" { return false }
                for req in target {
                    let hasItem = false
                    for elem in actual {
                        if DbUtil.equals(elem, req) {
                            hasItem = true
                            break
                        }
                    }
                    if not hasItem { return false }
                }
            } else if op == "$size" {
                if (type(actual) != "array" and type(actual) != "string") or len(actual) != target {
                    return false
                }
            } else if op == "$exists" {
                let want = target == true
                let hasVal = exists and actual != null
                if hasVal != want { return false }
            } else if op == "$type" {
                if not DbSchema.matchesType(actual, DbSchema.normalizeTypeName(target)) {
                    return false
                }
            } else {
                raise "unknown query operator: " + op
            }
        }
        return true
    }

    # â”€â”€ Update mutations ($set, $inc, $mul, $min, $max, $push, $pull, $unset) â”€â”€

    fn applyChanges(doc, changes) {
        let out = DbUtil.clone(doc)
        if changes == null or type(changes) != "dict" { return out }

        let hasOp = false
        for k in changes.keys() {
            if k.startsWith("$") {
                hasOp = true
                break
            }
        }

        if not hasOp {
            for k in changes.keys() {
                DbUtil.setPath(out, k, DbUtil.clone(changes[k]))
            }
            return out
        }

        for op in changes.keys() {
            let spec = changes[op]
            if type(spec) != "dict" and op != "$unset" { continue }

            if op == "$set" {
                for f in spec.keys() { DbUtil.setPath(out, f, DbUtil.clone(spec[f])) }
            } else if op == "$inc" {
                for f in spec.keys() {
                    let cur = DbUtil.getPath(out, f)
                    let base = type(cur) == "number" ? cur : 0
                    DbUtil.setPath(out, f, base + spec[f])
                }
            } else if op == "$mul" {
                for f in spec.keys() {
                    let cur = DbUtil.getPath(out, f)
                    let base = type(cur) == "number" ? cur : 0
                    DbUtil.setPath(out, f, base * spec[f])
                }
            } else if op == "$min" {
                for f in spec.keys() {
                    let cur = DbUtil.getPath(out, f)
                    if cur == null or DbUtil.compareValues(spec[f], cur) < 0 {
                        DbUtil.setPath(out, f, DbUtil.clone(spec[f]))
                    }
                }
            } else if op == "$max" {
                for f in spec.keys() {
                    let cur = DbUtil.getPath(out, f)
                    if cur == null or DbUtil.compareValues(spec[f], cur) > 0 {
                        DbUtil.setPath(out, f, DbUtil.clone(spec[f]))
                    }
                }
            } else if op == "$push" {
                for f in spec.keys() {
                    let cur = DbUtil.getPath(out, f)
                    let arr = type(cur) == "array" ? DbUtil.clone(cur) : []
                    arr.push(DbUtil.clone(spec[f]))
                    DbUtil.setPath(out, f, arr)
                }
            } else if op == "$pull" {
                for f in spec.keys() {
                    let cur = DbUtil.getPath(out, f)
                    if type(cur) == "array" {
                        let kept = []
                        for item in cur {
                            if not DbUtil.equals(item, spec[f]) { kept.push(item) }
                        }
                        DbUtil.setPath(out, f, kept)
                    }
                }
            } else if op == "$unset" {
                let fieldsToDrop = type(spec) == "array" ? spec : spec.keys()
                let trimmed = {}
                for k in out.keys() {
                    if not fieldsToDrop.contains(k) { trimmed[k] = out[k] }
                }
                out = trimmed
            }
        }
        return out
    }

    # â”€â”€ Projection (SELECT fields / aliases) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn projectRecord(doc, selectSpec) {
        if selectSpec == null { return DbUtil.clone(doc) }
        if type(selectSpec) == "array" {
            if len(selectSpec) == 0 or (len(selectSpec) == 1 and selectSpec[0] == "*") {
                return DbUtil.clone(doc)
            }
            let out = {}
            for item in selectSpec {
                if type(item) == "string" {
                    if item == "*" {
                        for k in doc.keys() { out[k] = DbUtil.clone(doc[k]) }
                    } else {
                        out[item] = DbUtil.clone(DbUtil.getPath(doc, item))
                    }
                } else if type(item) == "dict" {
                    let f = item.get("field", "")
                    let alias = item.get("as", f)
                    out[alias] = DbUtil.clone(DbUtil.getPath(doc, f))
                }
            }
            return out
        }
        return DbUtil.clone(doc)
    }

    fn project(records, selectSpec) {
        if selectSpec == null { return DbUtil.clone(records) }
        let out = []
        for r in records { out.push(self.projectRecord(r, selectSpec)) }
        return out
    }

    # â”€â”€ Joins (inner, left, lookup) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    # joinSpec: {
    #   "right": rightRecords, "localField": "id", "foreignField": "userId",
    #   "type": "inner" | "left" | "lookup", "as": "orders", "prefix": "order_"
    # }
    fn executeJoin(leftRecords, rightRecords, joinSpec) {
        let localField = joinSpec.get("localField", "id")
        let foreignField = joinSpec.get("foreignField", "id")
        let joinType = DbUtil.text(joinSpec.get("type", "inner")).lower()
        let asField = DbUtil.text(joinSpec.get("as", ""))
        let prefix = DbUtil.text(joinSpec.get("prefix", ""))

        # Build hash bucket on rightRecords by foreignField
        let buckets = {}
        for r in rightRecords {
            let fv = DbUtil.getPath(r, foreignField)
            if fv == null { continue }
            let key = DbUtil.safeKey(DbUtil.text(fv))
            if not (key in buckets) { buckets[key] = [] }
            buckets[key].push(r)
        }

        let out = []
        for l in leftRecords {
            let lv = DbUtil.getPath(l, localField)
            let key = lv == null ? "" : DbUtil.safeKey(DbUtil.text(lv))
            let matches = (key != "" and (key in buckets)) ? buckets[key] : []

            if joinType == "lookup" {
                let row = DbUtil.clone(l)
                let targetName = asField != "" ? asField : "matches"
                row[targetName] = DbUtil.clone(matches)
                out.push(row)
            } else if len(matches) > 0 {
                for m in matches {
                    let row = DbUtil.clone(l)
                    if asField != "" {
                        row[asField] = DbUtil.clone(m)
                    } else {
                        for mk in m.keys() {
                            let colName = prefix != "" ? (prefix + mk) : ((mk in row) ? (foreignField + "_" + mk) : mk)
                            row[colName] = DbUtil.clone(m[mk])
                        }
                    }
                    out.push(row)
                }
            } else if joinType == "left" {
                let row = DbUtil.clone(l)
                if asField != "" { row[asField] = null }
                out.push(row)
            }
        }
        return out
    }

    # â”€â”€ GroupBy & Aggregations (COUNT, SUM, AVG, MIN, MAX, DISTINCT) â”€â”€â”€â”€â”€

    # aggSpec: {
    #   "groupBy": "role" or ["department", "role"],
    #   "metrics": {"count": {"$count": "*"}, "totalSalary": {"$sum": "salary"}, "avgAge": {"$avg": "age"}},
    #   "having": {"count": {"$gte": 2}}
    # }
    fn aggregate(records, aggSpec) {
        let groupBy = aggSpec.get("groupBy", [])
        if type(groupBy) == "string" {
            groupBy = groupBy == "" ? [] : [groupBy]
        }
        let metrics = aggSpec.get("metrics", {"count": {"$count": "*"}})
        let having = aggSpec.get("having", null)

        let groups = {}
        let groupOrder = []
        let sep = chr(1)

        for r in records {
            let keyParts = []
            let groupValues = {}
            for gf in groupBy {
                let gv = DbUtil.getPath(r, gf)
                keyParts.push(DbUtil.text(gv))
                groupValues[gf] = gv
            }
            let rawKey = len(keyParts) == 0 ? "__all__" : keyParts.join(sep)
            let sk = DbUtil.safeKey(rawKey)
            if not (sk in groups) {
                groups[sk] = {"keys": groupValues, "rows": []}
                groupOrder.push(sk)
            }
            groups[sk]["rows"].push(r)
        }

        if len(groupOrder) == 0 and len(groupBy) == 0 {
            let sk = "__all__"
            groups[sk] = {"keys": {}, "rows": []}
            groupOrder.push(sk)
        }

        let out = []
        for sk in groupOrder {
            let g = groups[sk]
            let rows = g["rows"]
            let resultRow = DbUtil.clone(g["keys"])

            for alias in metrics.keys() {
                let mSpec = metrics[alias]
                resultRow[alias] = self.computeMetric(rows, mSpec)
            }

            if having == null or self.matches(resultRow, having) {
                out.push(resultRow)
            }
        }
        return out
    }

    fn computeMetric(rows, mSpec) {
        if type(mSpec) != "dict" { return null }
        let ops = mSpec.keys()
        if len(ops) == 0 { return null }
        let op = ops[0].lower()
        let field = DbUtil.text(mSpec[ops[0]])

        if op == "$count" or op == "count" {
            if field == "*" or field == "" { return len(rows) }
            let n = 0
            for r in rows {
                if DbUtil.getPath(r, field) != null { n += 1 }
            }
            return n
        }

        let nums = []
        let vals = []
        for r in rows {
            let v = DbUtil.getPath(r, field)
            if v != null {
                vals.push(v)
                if type(v) == "number" { nums.push(v) }
            }
        }

        if op == "$sum" or op == "sum" {
            let s = 0
            for x in nums { s += x }
            return s
        }
        if op == "$avg" or op == "avg" {
            if len(nums) == 0 { return 0 }
            let s = 0.0
            for x in nums { s += x }
            return DbUtil.roundTo(s / len(nums), 4)
        }
        if op == "$min" or op == "min" {
            if len(vals) == 0 { return null }
            let best = vals[0]
            for i in range(1, len(vals)) {
                if DbUtil.compareValues(vals[i], best) < 0 { best = vals[i] }
            }
            return best
        }
        if op == "$max" or op == "max" {
            if len(vals) == 0 { return null }
            let best = vals[0]
            for i in range(1, len(vals)) {
                if DbUtil.compareValues(vals[i], best) > 0 { best = vals[i] }
            }
            return best
        }
        if op == "$distinct" or op == "distinct" {
            let uniq = []
            for v in vals {
                let seen = false
                for u in uniq {
                    if DbUtil.equals(v, u) {
                        seen = true
                        break
                    }
                }
                if not seen { uniq.push(v) }
            }
            return uniq
        }
        return null
    }
}

DbQuery = __QDbQuery()

# ── module: ./src/sql.sa (src/sql.sa) ──
# quantum-db / sql â€” SQL parser and executor for SELECT, INSERT, UPDATE, DELETE, CREATE and DROP
#
#   DbSql.execute(db, "SELECT name, age FROM users WHERE age >= 21 AND role = 'admin' ORDER BY age DESC LIMIT 5")
#   DbSql.execute(db, "SELECT role, COUNT(*) AS count, AVG(age) AS avgAge FROM users GROUP BY role")
#   DbSql.execute(db, "INSERT INTO users (name, age, role) VALUES ('Grace', 34, 'admin')")
#
# Exposes the global: DbSql

class __QDbSql {
    fn init() {}

    # Tokenizes a SQL statement into tokens:
    # [{"kind": "word"|"string"|"number"|"symbol", "value": "...", "upper": "..."}]
    fn tokenize(sqlText) {
        let s = DbUtil.text(sqlText).trim()
        if s.endsWith(";") { s = s.slice(0, len(s) - 1).trim() }
        let tokens = []
        let i = 0
        let n = len(s)

        while i < n {
            while i < n and DbUtil.isSpace(s[i]) { i += 1 }
            if i >= n { break }

            let ch = s[i]
            if ch == "'" or ch == "\"" {
                let quote = ch
                i += 1
                let start = i
                let buf = []
                while i < n {
                    if s[i] == quote {
                        if i + 1 < n and s[i + 1] == quote {
                            buf.push(quote)
                            i += 2
                            continue
                        }
                        break
                    }
                    buf.push(s[i])
                    i += 1
                }
                if i < n and s[i] == quote { i += 1 }
                let strVal = buf.join("")
                tokens.push({"kind": "string", "value": strVal, "upper": strVal.upper()})
                continue
            }

            # Two-character comparison operators
            if i + 1 < n {
                let two = s.slice(i, i + 2)
                if two == ">=" or two == "<=" or two == "!=" or two == "<>" {
                    tokens.push({"kind": "symbol", "value": two, "upper": two})
                    i += 2
                    continue
                }
            }

            if ch == "(" or ch == ")" or ch == "," or ch == "=" or ch == ">" or ch == "<" or ch == "*" {
                tokens.push({"kind": "symbol", "value": ch, "upper": ch})
                i += 1
                continue
            }

            # Number or identifier (including dotted table.column)
            let start = i
            while i < n and not DbUtil.isSpace(s[i]) and s[i] != "(" and s[i] != ")" and s[i] != "," and s[i] != "=" and s[i] != ">" and s[i] != "<" and s[i] != "'" and s[i] != "\"" {
                if i + 1 < n and s.slice(i, i + 2) == "!=" { break }
                i += 1
            }
            let raw = s.slice(start, i)
            if DbUtil.isNumericString(raw) {
                tokens.push({"kind": "number", "value": num(raw), "upper": raw})
            } else {
                tokens.push({"kind": "word", "value": raw, "upper": raw.upper()})
            }
        }
        return tokens
    }

    fn stripTablePrefix(colName) {
        let s = DbUtil.text(colName)
        let dot = s.indexOf(".")
        if dot > 0 { return s.slice(dot + 1) }
        return s
    }

    fn literalFromToken(tok) {
        if tok["kind"] == "string" { return tok["value"] }
        if tok["kind"] == "number" { return tok["value"] }
        let u = tok["upper"]
        if u == "TRUE" { return true }
        if u == "FALSE" { return false }
        if u == "NULL" or u == "NIL" { return null }
        return tok["value"]
    }

    # Parses a SQL statement into an AST dict.
    fn parse(sqlText) {
        let tokens = self.tokenize(sqlText)
        if len(tokens) == 0 { raise "empty SQL statement" }
        let first = tokens[0]["upper"]
        if first == "SELECT" { return self.parseSelect(tokens) }
        if first == "INSERT" { return self.parseInsert(tokens) }
        if first == "UPDATE" { return self.parseUpdate(tokens) }
        if first == "DELETE" { return self.parseDelete(tokens) }
        if first == "CREATE" { return self.parseCreate(tokens) }
        if first == "DROP" { return self.parseDrop(tokens) }
        raise "unsupported SQL command: " + tokens[0]["value"]
    }

    # â”€â”€ CREATE TABLE & DROP TABLE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn parseCreate(tokens) {
        let i = 1
        if i < len(tokens) and tokens[i]["upper"] == "TABLE" { i += 1 }
        if i + 2 < len(tokens) and tokens[i]["upper"] == "IF" and tokens[i + 1]["upper"] == "NOT" and tokens[i + 2]["upper"] == "EXISTS" {
            i += 3
        }
        if i >= len(tokens) { raise "CREATE TABLE missing table name" }
        let table = tokens[i]["value"]
        i += 1

        let schema = {}
        let primaryKey = "id"
        let uniqueFields = []

        if i < len(tokens) and tokens[i]["value"] == "(" {
            i += 1
            while i < len(tokens) and tokens[i]["value"] != ")" {
                if tokens[i]["value"] == "," {
                    i += 1
                    continue
                }
                let colName = tokens[i]["value"]
                i += 1
                let colType = "any"
                if i < len(tokens) and tokens[i]["value"] != "," and tokens[i]["value"] != ")" {
                    colType = DbSchema.normalizeTypeName(tokens[i]["value"])
                    i += 1
                }
                let rule = {"type": colType, "required": false}
                while i < len(tokens) and tokens[i]["value"] != "," and tokens[i]["value"] != ")" {
                    let kw = tokens[i]["upper"]
                    if kw == "PRIMARY" {
                        primaryKey = colName
                        rule["primaryKey"] = true
                        rule["required"] = true
                        i += 1
                        if i < len(tokens) and tokens[i]["upper"] == "KEY" { i += 1 }
                    } else if kw == "REQUIRED" {
                        rule["required"] = true
                        i += 1
                    } else if kw == "NOT" and i + 1 < len(tokens) and tokens[i + 1]["upper"] == "NULL" {
                        rule["required"] = true
                        i += 2
                    } else if kw == "UNIQUE" {
                        uniqueFields.push(colName)
                        i += 1
                    } else if kw == "DEFAULT" and i + 1 < len(tokens) {
                        rule["default"] = self.literalFromToken(tokens[i + 1])
                        i += 2
                    } else {
                        i += 1
                    }
                }
                schema[colName] = rule
            }
        }

        return {
            "command": "CREATE_TABLE",
            "table": table,
            "schema": schema,
            "primaryKey": primaryKey,
            "unique": uniqueFields
        }
    }

    fn parseDrop(tokens) {
        let i = 1
        if i < len(tokens) and tokens[i]["upper"] == "TABLE" { i += 1 }
        if i + 1 < len(tokens) and tokens[i]["upper"] == "IF" and tokens[i + 1]["upper"] == "EXISTS" {
            i += 2
        }
        if i >= len(tokens) { raise "DROP TABLE missing table name" }
        return {"command": "DROP_TABLE", "table": tokens[i]["value"]}
    }

    # â”€â”€ INSERT INTO â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn parseInsert(tokens) {
        let i = 1
        if i < len(tokens) and tokens[i]["upper"] == "INTO" { i += 1 }
        if i >= len(tokens) { raise "INSERT missing table name" }
        let table = tokens[i]["value"]
        i += 1

        let columns = []
        if i < len(tokens) and tokens[i]["value"] == "(" {
            i += 1
            while i < len(tokens) and tokens[i]["value"] != ")" {
                if tokens[i]["value"] != "," { columns.push(tokens[i]["value"]) }
                i += 1
            }
            if i < len(tokens) and tokens[i]["value"] == ")" { i += 1 }
        }

        if i < len(tokens) and tokens[i]["upper"] == "VALUES" { i += 1 }
        let rows = []
        while i < len(tokens) {
            if tokens[i]["value"] == "," {
                i += 1
                continue
            }
            if tokens[i]["value"] == "(" {
                i += 1
                let vals = []
                while i < len(tokens) and tokens[i]["value"] != ")" {
                    if tokens[i]["value"] != "," {
                        vals.push(self.literalFromToken(tokens[i]))
                    }
                    i += 1
                }
                if i < len(tokens) and tokens[i]["value"] == ")" { i += 1 }
                let doc = {}
                for k in range(len(vals)) {
                    let col = k < len(columns) ? columns[k] : ("col" + DbUtil.text(k + 1))
                    doc[col] = vals[k]
                }
                rows.push(doc)
            } else {
                break
            }
        }
        return {"command": "INSERT", "table": table, "rows": rows}
    }

    # â”€â”€ WHERE clause parser â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn parseWhereTokens(tokens, startIdx, stopKeywords) {
        let i = startIdx
        let n = len(tokens)
        let orGroups = []
        let currentAnd = []

        while i < n {
            let u = tokens[i]["upper"]
            if stopKeywords.contains(u) { break }
            if u == "AND" {
                i += 1
                continue
            }
            if u == "OR" {
                if len(currentAnd) > 0 {
                    orGroups.push(self.combineAnd(currentAnd))
                    currentAnd = []
                }
                i += 1
                continue
            }

            let field = self.stripTablePrefix(tokens[i]["value"])
            i += 1
            if i >= n { break }

            let opTok = tokens[i]["upper"]
            # IS NULL / IS NOT NULL
            if opTok == "IS" {
                i += 1
                let notNull = false
                if i < n and tokens[i]["upper"] == "NOT" {
                    notNull = true
                    i += 1
                }
                if i < n and tokens[i]["upper"] == "NULL" { i += 1 }
                let cond = {}
                cond[field] = {"$exists": notNull}
                currentAnd.push(cond)
                continue
            }

            # IN (v1, v2, ...)
            if opTok == "IN" {
                i += 1
                let listVals = []
                if i < n and tokens[i]["value"] == "(" {
                    i += 1
                    while i < n and tokens[i]["value"] != ")" {
                        if tokens[i]["value"] != "," {
                            listVals.push(self.literalFromToken(tokens[i]))
                        }
                        i += 1
                    }
                    if i < n and tokens[i]["value"] == ")" { i += 1 }
                }
                let cond = {}
                cond[field] = {"$in": listVals}
                currentAnd.push(cond)
                continue
            }

            # Standard binary comparison (=, !=, <>, >, >=, <, <=, LIKE, ILIKE)
            i += 1
            if i >= n { break }
            let rhs = self.literalFromToken(tokens[i])
            i += 1

            let cond = {}
            if opTok == "=" {
                cond[field] = rhs
            } else if opTok == "!=" or opTok == "<>" {
                cond[field] = {"$ne": rhs}
            } else if opTok == ">" {
                cond[field] = {"$gt": rhs}
            } else if opTok == ">=" {
                cond[field] = {"$gte": rhs}
            } else if opTok == "<" {
                cond[field] = {"$lt": rhs}
            } else if opTok == "<=" {
                cond[field] = {"$lte": rhs}
            } else if opTok == "LIKE" {
                cond[field] = {"$like": DbUtil.text(rhs)}
            } else if opTok == "ILIKE" {
                cond[field] = {"$ilike": DbUtil.text(rhs)}
            } else {
                cond[field] = rhs
            }
            currentAnd.push(cond)
        }

        if len(currentAnd) > 0 {
            orGroups.push(self.combineAnd(currentAnd))
        }
        let whereSpec = {}
        if len(orGroups) == 1 {
            whereSpec = orGroups[0]
        } else if len(orGroups) > 1 {
            whereSpec = {"$or": orGroups}
        }
        return {"where": whereSpec, "nextIndex": i}
    }

    fn combineAnd(condList) {
        if len(condList) == 0 { return {} }
        if len(condList) == 1 { return condList[0] }
        return {"$and": condList}
    }

    # â”€â”€ SELECT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn parseSelect(tokens) {
        let i = 1
        let n = len(tokens)
        let selectCols = []
        let aggMetrics = {}
        let hasAgg = false

        while i < n and tokens[i]["upper"] != "FROM" {
            if tokens[i]["value"] == "," {
                i += 1
                continue
            }
            let tok = tokens[i]
            let fnUpper = tok["upper"]
            if (fnUpper == "COUNT" or fnUpper == "SUM" or fnUpper == "AVG" or fnUpper == "MIN" or fnUpper == "MAX") and i + 1 < n and tokens[i + 1]["value"] == "(" {
                hasAgg = true
                i += 2
                let argField = "*"
                if i < n and tokens[i]["value"] != ")" {
                    argField = self.stripTablePrefix(tokens[i]["value"])
                    i += 1
                }
                if i < n and tokens[i]["value"] == ")" { i += 1 }
                let alias = fnUpper.lower() + (argField == "*" ? "" : ("_" + argField))
                if i < n and tokens[i]["upper"] == "AS" and i + 1 < n {
                    alias = tokens[i + 1]["value"]
                    i += 2
                }
                let mSpec = {}
                mSpec["$" + fnUpper.lower()] = argField
                aggMetrics[alias] = mSpec
                continue
            }

            let colName = self.stripTablePrefix(tok["value"])
            i += 1
            let alias = colName
            if i < n and tokens[i]["upper"] == "AS" and i + 1 < n {
                alias = tokens[i + 1]["value"]
                i += 2
            }
            if alias != colName {
                selectCols.push({"field": colName, "as": alias})
            } else {
                selectCols.push(colName)
            }
        }

        if i < n and tokens[i]["upper"] == "FROM" { i += 1 }
        if i >= n { raise "SELECT missing table name after FROM" }
        let table = tokens[i]["value"]
        i += 1

        # Optional JOIN: [INNER | LEFT] JOIN <table> ON <a.x> = <b.y>
        let joinSpec = null
        if i < n and (tokens[i]["upper"] == "JOIN" or tokens[i]["upper"] == "INNER" or tokens[i]["upper"] == "LEFT") {
            let joinType = "inner"
            if tokens[i]["upper"] == "LEFT" {
                joinType = "left"
                i += 1
            } else if tokens[i]["upper"] == "INNER" {
                i += 1
            }
            if i < n and tokens[i]["upper"] == "JOIN" { i += 1 }
            let rightTable = tokens[i]["value"]
            i += 1
            if i < n and tokens[i]["upper"] == "ON" { i += 1 }
            let leftCol = self.stripTablePrefix(tokens[i]["value"])
            i += 1
            if i < n and tokens[i]["value"] == "=" { i += 1 }
            let rightCol = self.stripTablePrefix(tokens[i]["value"])
            i += 1
            joinSpec = {
                "table": rightTable,
                "localField": leftCol,
                "foreignField": rightCol,
                "type": joinType
            }
        }

        let stopWords = ["GROUP", "ORDER", "LIMIT", "OFFSET"]
        let whereSpec = null
        if i < n and tokens[i]["upper"] == "WHERE" {
            let parsedWhere = self.parseWhereTokens(tokens, i + 1, stopWords)
            whereSpec = parsedWhere["where"]
            i = parsedWhere["nextIndex"]
        }

        let groupBy = []
        if i + 1 < n and tokens[i]["upper"] == "GROUP" and tokens[i + 1]["upper"] == "BY" {
            i += 2
            while i < n and tokens[i]["upper"] != "ORDER" and tokens[i]["upper"] != "LIMIT" and tokens[i]["upper"] != "OFFSET" {
                if tokens[i]["value"] != "," {
                    groupBy.push(self.stripTablePrefix(tokens[i]["value"]))
                }
                i += 1
            }
        }

        let orderBy = []
        if i + 1 < n and tokens[i]["upper"] == "ORDER" and tokens[i + 1]["upper"] == "BY" {
            i += 2
            while i < n and tokens[i]["upper"] != "LIMIT" and tokens[i]["upper"] != "OFFSET" {
                if tokens[i]["value"] == "," {
                    i += 1
                    continue
                }
                let f = self.stripTablePrefix(tokens[i]["value"])
                i += 1
                let desc = false
                if i < n and (tokens[i]["upper"] == "ASC" or tokens[i]["upper"] == "DESC") {
                    desc = tokens[i]["upper"] == "DESC"
                    i += 1
                }
                orderBy.push({"field": f, "desc": desc})
            }
        }

        let limit = 0
        let offset = 0
        while i < n {
            if tokens[i]["upper"] == "LIMIT" and i + 1 < n {
                limit = tokens[i + 1]["value"]
                i += 2
            } else if tokens[i]["upper"] == "OFFSET" and i + 1 < n {
                offset = tokens[i + 1]["value"]
                i += 2
            } else {
                i += 1
            }
        }

        return {
            "command": "SELECT",
            "table": table,
            "select": selectCols,
            "hasAgg": hasAgg or len(groupBy) > 0,
            "groupBy": groupBy,
            "metrics": aggMetrics,
            "join": joinSpec,
            "where": whereSpec,
            "orderBy": orderBy,
            "limit": limit,
            "offset": offset
        }
    }

    # â”€â”€ UPDATE & DELETE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn parseUpdate(tokens) {
        let i = 1
        if i >= len(tokens) { raise "UPDATE missing table name" }
        let table = tokens[i]["value"]
        i += 1
        if i < len(tokens) and tokens[i]["upper"] == "SET" { i += 1 }

        let changes = {}
        while i < len(tokens) and tokens[i]["upper"] != "WHERE" {
            if tokens[i]["value"] == "," {
                i += 1
                continue
            }
            let col = tokens[i]["value"]
            i += 1
            if i < len(tokens) and tokens[i]["value"] == "=" { i += 1 }
            if i < len(tokens) {
                changes[col] = self.literalFromToken(tokens[i])
                i += 1
            }
        }

        let whereSpec = null
        if i < len(tokens) and tokens[i]["upper"] == "WHERE" {
            let parsedWhere = self.parseWhereTokens(tokens, i + 1, [])
            whereSpec = parsedWhere["where"]
        }
        return {"command": "UPDATE", "table": table, "changes": changes, "where": whereSpec}
    }

    fn parseDelete(tokens) {
        let i = 1
        if i < len(tokens) and tokens[i]["upper"] == "FROM" { i += 1 }
        if i >= len(tokens) { raise "DELETE missing table name" }
        let table = tokens[i]["value"]
        i += 1
        let whereSpec = null
        if i < len(tokens) and tokens[i]["upper"] == "WHERE" {
            let parsedWhere = self.parseWhereTokens(tokens, i + 1, [])
            whereSpec = parsedWhere["where"]
        }
        return {"command": "DELETE", "table": table, "where": whereSpec}
    }

    # â”€â”€ Executor â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn execute(db, sqlText) {
        let ast = self.parse(sqlText)
        let cmd = ast["command"]
        let table = ast["table"]

        if cmd == "CREATE_TABLE" {
            Db.createCollection(db, table, {
                "schema": ast["schema"],
                "primaryKey": ast["primaryKey"],
                "unique": ast["unique"]
            })
            return {"command": cmd, "table": table, "ok": true}
        }
        if cmd == "DROP_TABLE" {
            let dropped = Db.dropCollection(db, table)
            return {"command": cmd, "table": table, "dropped": dropped}
        }
        if cmd == "INSERT" {
            let inserted = Db.insertMany(db, table, ast["rows"])
            return {"command": cmd, "table": table, "insertedCount": len(inserted), "rows": inserted}
        }
        if cmd == "UPDATE" {
            let updated = Db.update(db, table, ast["where"], ast["changes"])
            return {"command": cmd, "table": table, "updatedCount": updated}
        }
        if cmd == "DELETE" {
            let deleted = Db.remove(db, table, ast["where"])
            return {"command": cmd, "table": table, "deletedCount": deleted}
        }
        if cmd == "SELECT" {
            let querySpec = {
                "where": ast["where"],
                "orderBy": ast["orderBy"],
                "limit": ast["limit"],
                "offset": ast["offset"]
            }
            if ast["join"] != null {
                querySpec["join"] = ast["join"]
            }
            if ast["hasAgg"] {
                querySpec["groupBy"] = ast["groupBy"]
                querySpec["metrics"] = ast["metrics"]
            } else if len(ast["select"]) > 0 {
                querySpec["select"] = ast["select"]
            }
            return Db.find(db, table, querySpec)
        }
        raise "unknown SQL command: " + cmd
    }
}

DbSql = __QDbSql()

# ── module: ./src/format.sa (src/format.sa) ──
# quantum-db / format â€” ASCII/Unicode tables, Markdown tables, CSV and JSONL import/export
#
#   print(DbFormat.table(rows, ["id", "name", "role", "age"]))
#   print(DbFormat.markdown(rows, ["id", "name", "role"]))
#   let csvText = DbFormat.csv(rows, null)
#   let parsed  = DbFormat.parseCsv(csvText, {"autoTypes": true})
#
# Exposes the global: DbFormat

class __QDbFormat {
    fn init() {}

    fn formatCell(value) {
        if value == null { return "NULL" }
        if type(value) == "array" or type(value) == "dict" {
            return JSON.stringify(value)
        }
        return DbUtil.text(value)
    }

    # Infers ordered column headers from `records` when `columns` is null or empty.
    fn columnsOf(records, columns) {
        if columns != null and type(columns) == "array" and len(columns) > 0 {
            return columns
        }
        let cols = []
        let seen = {}
        if records == null or len(records) == 0 { return cols }

        # Put "id" first when present
        for r in records {
            if type(r) == "dict" and ("id" in r) and not ("id" in seen) {
                seen["id"] = true
                cols.push("id")
                break
            }
        }
        for r in records {
            if type(r) != "dict" { continue }
            for k in r.keys() {
                let sk = DbUtil.safeKey(k)
                if not (sk in seen) {
                    seen[sk] = true
                    cols.push(k)
                }
            }
        }
        return cols
    }

    fn repeatChar(ch, count) {
        let out = []
        for i in range(count) { out.push(ch) }
        return out.join("")
    }

    fn padCell(text, width, rightAlign) {
        let s = DbUtil.text(text)
        let diff = width - len(s)
        if diff <= 0 { return s }
        let spaces = self.repeatChar(" ", diff)
        return rightAlign ? (spaces + s) : (s + spaces)
    }

    # Renders `records` as an ASCII box table (`+----+------+`).
    fn table(records, columns) {
        if records == null or len(records) == 0 {
            return "(0 rows)"
        }
        let cols = self.columnsOf(records, columns)
        if len(cols) == 0 { return "(0 columns)" }

        let widths = []
        let numericCols = []
        for c in cols {
            widths.push(len(DbUtil.text(c)))
            numericCols.push(true)
        }

        let matrix = []
        for r in records {
            let rowCells = []
            for j in range(len(cols)) {
                let colName = cols[j]
                let rawVal = DbUtil.getPath(r, colName)
                if rawVal != null and type(rawVal) != "number" {
                    numericCols[j] = false
                }
                let cellText = self.formatCell(rawVal)
                if len(cellText) > widths[j] { widths[j] = len(cellText) }
                rowCells.push(cellText)
            }
            matrix.push(rowCells)
        }

        let sepParts = ["+"]
        let headParts = ["|"]
        for j in range(len(cols)) {
            sepParts.push(self.repeatChar("-", widths[j] + 2) + "+")
            headParts.push(" " + self.padCell(cols[j], widths[j], false) + " |")
        }
        let border = sepParts.join("")
        let lines = [border, headParts.join(""), border]

        for rowCells in matrix {
            let lineParts = ["|"]
            for j in range(len(cols)) {
                lineParts.push(" " + self.padCell(rowCells[j], widths[j], numericCols[j]) + " |")
            }
            lines.push(lineParts.join(""))
        }
        lines.push(border)
        return lines.join("\n")
    }

    # Renders `records` as a GitHub-flavored Markdown table.
    fn markdown(records, columns) {
        if records == null or len(records) == 0 { return "" }
        let cols = self.columnsOf(records, columns)
        if len(cols) == 0 { return "" }

        let head = []
        let align = []
        for c in cols {
            head.push(DbUtil.text(c).replaceAll("|", "\\|"))
            align.push("---")
        }
        let lines = [
            "| " + head.join(" | ") + " |",
            "| " + align.join(" | ") + " |"
        ]
        for r in records {
            let cells = []
            for c in cols {
                let v = DbUtil.getPath(r, c)
                let txt = v == null ? "" : self.formatCell(v).replaceAll("|", "\\|").replaceAll("\n", " ")
                cells.push(txt)
            }
            lines.push("| " + cells.join(" | ") + " |")
        }
        return lines.join("\n")
    }

    # â”€â”€ CSV export & import â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn escapeCsvField(value) {
        if value == null { return "" }
        let s = (type(value) == "array" or type(value) == "dict") ? JSON.stringify(value) : DbUtil.text(value)
        if s.contains(",") or s.contains("\"") or s.contains("\n") or s.contains("\r") {
            return "\"" + s.replaceAll("\"", "\"\"") + "\""
        }
        return s
    }

    fn csv(records, columns) {
        if records == null or len(records) == 0 { return "" }
        let cols = self.columnsOf(records, columns)
        let lines = []
        let headerCells = []
        for c in cols { headerCells.push(self.escapeCsvField(c)) }
        lines.push(headerCells.join(","))

        for r in records {
            let rowCells = []
            for c in cols {
                rowCells.push(self.escapeCsvField(DbUtil.getPath(r, c)))
            }
            lines.push(rowCells.join(","))
        }
        return lines.join("\n")
    }

    # Parses CSV text into an array of row dicts using the first row as column headers.
    fn parseCsv(csvText, options) {
        let autoTypes = options == null or options.get("autoTypes", true) == true
        let s = DbUtil.text(csvText).replaceAll("\r\n", "\n").replaceAll("\r", "\n")
        let rows = self.parseCsvRows(s)
        if len(rows) <= 1 { return [] }

        let headers = []
        for h in rows[0] { headers.push(h.trim()) }

        let out = []
        for i in range(1, len(rows)) {
            let row = rows[i]
            if len(row) == 1 and row[0].trim() == "" { continue }
            let doc = {}
            for j in range(len(headers)) {
                let col = headers[j]
                if col == "" { continue }
                let rawVal = j < len(row) ? row[j] : ""
                doc[col] = autoTypes ? DbUtil.autoValue(rawVal) : rawVal
            }
            out.push(doc)
        }
        return out
    }

    fn parseCsvRows(s) {
        let rows = []
        let currentRow = []
        let buf = []
        let inQuotes = false
        let i = 0
        let n = len(s)

        while i < n {
            let ch = s[i]
            if inQuotes {
                if ch == "\"" {
                    if i + 1 < n and s[i + 1] == "\"" {
                        buf.push("\"")
                        i += 2
                        continue
                    }
                    inQuotes = false
                    i += 1
                    continue
                }
                buf.push(ch)
                i += 1
            } else {
                if ch == "\"" {
                    inQuotes = true
                    i += 1
                } else if ch == "," {
                    currentRow.push(buf.join(""))
                    buf = []
                    i += 1
                } else if ch == "\n" {
                    currentRow.push(buf.join(""))
                    buf = []
                    rows.push(currentRow)
                    currentRow = []
                    i += 1
                } else {
                    buf.push(ch)
                    i += 1
                }
            }
        }
        if len(buf) > 0 or len(currentRow) > 0 {
            currentRow.push(buf.join(""))
            rows.push(currentRow)
        }
        return rows
    }

    # â”€â”€ JSON Lines (JSONL) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn jsonl(records) {
        let lines = []
        if records == null { return "" }
        for r in records { lines.push(JSON.stringify(r)) }
        return lines.join("\n")
    }

    fn parseJsonl(text) {
        let s = DbUtil.text(text).replaceAll("\r\n", "\n").replaceAll("\r", "\n")
        let out = []
        for line in s.split("\n") {
            let t = line.trim()
            if t != "" { out.push(JSON.parse(t)) }
        }
        return out
    }
}

DbFormat = __QDbFormat()

# ── module: ./src/engine.sa (src/engine.sa) ──
# quantum-db / engine â€” embedded multi-collection database, indexes, CRUD, transactions & SQL
#
#   let db = Db.create({"name": "shop"})
#   Db.insert(db, "users", {"name": "Ada", "role": "admin", "age": 28})
#   let admins = Db.find(db, "users", {"where": {"role": "admin"}, "orderBy": "age:desc"})
#   let rows   = Db.sql(db, "SELECT name, age FROM users WHERE age >= 21")
#
# Exposes the global: Db

class __QDbEngine {
    fn init() {
        self.VERSION = "1.0.0"
    }

    # Creates a new in-memory database dict.
    fn create(options) {
        let name = options != null ? DbUtil.text(options.get("name", "quantum-db")) : "quantum-db"
        return {
            "version": self.VERSION,
            "name": name,
            "collections": {},
            "snapshots": []
        }
    }

    # Creates or configures a collection inside `db`.
    # options: "primaryKey" (default "id"), "autoIncrement" (default true),
    #          "schema" (dict), "unique" (array of field names), "indexes" (array of field names)
    fn createCollection(db, name, options) {
        let colName = DbUtil.text(name).trim()
        if colName == "" { raise "collection name cannot be empty" }
        let sk = DbUtil.safeKey(colName)
        if sk in db["collections"] {
            return db["collections"][sk]
        }

        let pk = options != null ? DbUtil.text(options.get("primaryKey", "id")) : "id"
        let autoInc = options == null or options.get("autoIncrement", true) == true
        let rawSchema = options != null ? options.get("schema", {}) : {}
        let schema = DbSchema.normalize(rawSchema)

        let col = {
            "name": colName,
            "primaryKey": pk,
            "autoIncrement": autoInc,
            "nextId": 1,
            "schema": schema,
            "rows": {},
            "order": [],
            "indexes": {}
        }
        db["collections"][sk] = col

        if options != null {
            let uniques = options.get("unique", [])
            if type(uniques) == "array" {
                for uField in uniques { self.createIndex(db, colName, uField, true) }
            }
            let idxFields = options.get("indexes", [])
            if type(idxFields) == "array" {
                for iField in idxFields { self.createIndex(db, colName, iField, false) }
            }
        }
        return col
    }

    fn ensureCollection(db, name) {
        let sk = DbUtil.safeKey(DbUtil.text(name).trim())
        if sk in db["collections"] { return db["collections"][sk] }
        return self.createCollection(db, name, {})
    }

    fn hasCollection(db, name) {
        return DbUtil.safeKey(DbUtil.text(name).trim()) in db["collections"]
    }

    fn dropCollection(db, name) {
        let sk = DbUtil.safeKey(DbUtil.text(name).trim())
        if not (sk in db["collections"]) { return false }
        let kept = {}
        for k in db["collections"].keys() {
            if k != sk { kept[k] = db["collections"][k] }
        }
        db["collections"] = kept
        return true
    }

    fn listCollections(db) {
        let names = []
        for k in db["collections"].keys() {
            names.push(db["collections"][k]["name"])
        }
        return DbUtil.sortStrings(names)
    }

    # â”€â”€ Secondary & Unique Hash Indexes â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn createIndex(db, collectionName, field, unique) {
        let col = self.ensureCollection(db, collectionName)
        let f = DbUtil.text(field).trim()
        let fKey = DbUtil.safeKey(f)
        let isUnique = unique == true
        col["indexes"][fKey] = {
            "field": f,
            "unique": isUnique,
            "buckets": {}
        }
        self.rebuildIndex(col, fKey)
        return true
    }

    fn rebuildIndex(col, fKey) {
        let idxDef = col["indexes"][fKey]
        let field = idxDef["field"]
        let isUnique = idxDef["unique"]
        let buckets = {}

        for pkKey in col["order"] {
            let doc = col["rows"][pkKey]
            let val = DbUtil.getPath(doc, field)
            if val == null { continue }
            let valKey = DbUtil.safeKey(DbUtil.text(val))
            if isUnique and (valKey in buckets) and len(buckets[valKey]) > 0 {
                raise "unique constraint violated on " + col["name"] + "." + field + " = " + DbUtil.text(val)
            }
            if not (valKey in buckets) { buckets[valKey] = [] }
            buckets[valKey].push(pkKey)
        }
        idxDef["buckets"] = buckets
    }

    fn rebuildAllIndexes(col) {
        for fKey in col["indexes"].keys() {
            self.rebuildIndex(col, fKey)
        }
    }

    fn checkUniqueConstraints(col, candidateDoc, ignorePkKey) {
        for fKey in col["indexes"].keys() {
            let idxDef = col["indexes"][fKey]
            if not idxDef["unique"] { continue }
            let field = idxDef["field"]
            let val = DbUtil.getPath(candidateDoc, field)
            if val == null { continue }
            let valKey = DbUtil.safeKey(DbUtil.text(val))
            let buckets = idxDef["buckets"]
            if valKey in buckets {
                for existingPk in buckets[valKey] {
                    if existingPk != ignorePkKey {
                        raise "unique constraint violated on " + col["name"] + "." + field + " = " + DbUtil.text(val)
                    }
                }
            }
        }
    }

    # â”€â”€ CRUD: Insert, Get, Find, Update, Remove â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn insert(db, collectionName, rawDoc) {
        let col = self.ensureCollection(db, collectionName)
        let pkField = col["primaryKey"]
        let doc = DbSchema.prepare(col["schema"], rawDoc)

        let nextIdCandidate = col["nextId"]
        if not (pkField in doc) or doc[pkField] == null or doc[pkField] == "" {
            if col["autoIncrement"] {
                while DbUtil.safeKey(DbUtil.text(nextIdCandidate)) in col["rows"] {
                    nextIdCandidate = nextIdCandidate + 1
                }
                doc[pkField] = nextIdCandidate
                nextIdCandidate = nextIdCandidate + 1
            } else {
                raise "missing primary key '" + pkField + "' on insert into " + col["name"]
            }
        } else if type(doc[pkField]) == "number" and doc[pkField] >= nextIdCandidate {
            nextIdCandidate = floor(doc[pkField]) + 1
        }

        let pkKey = DbUtil.safeKey(DbUtil.text(doc[pkField]))
        if pkKey in col["rows"] {
            raise "duplicate primary key '" + DbUtil.text(doc[pkField]) + "' in " + col["name"]
        }

        DbSchema.assertValid(col["schema"], doc)
        self.checkUniqueConstraints(col, doc, "")

        col["nextId"] = nextIdCandidate
        col["rows"][pkKey] = doc
        col["order"].push(pkKey)
        self.rebuildAllIndexes(col)
        return DbUtil.clone(doc)
    }

    fn insertMany(db, collectionName, docs) {
        let out = []
        for d in docs { out.push(self.insert(db, collectionName, d)) }
        return out
    }

    fn get(db, collectionName, id) {
        if not self.hasCollection(db, collectionName) { return null }
        let col = self.ensureCollection(db, collectionName)
        let pkKey = DbUtil.safeKey(DbUtil.text(id))
        if not (pkKey in col["rows"]) { return null }
        return DbUtil.clone(col["rows"][pkKey])
    }

    fn has(db, collectionName, id) {
        if not self.hasCollection(db, collectionName) { return false }
        let col = self.ensureCollection(db, collectionName)
        let pkKey = DbUtil.safeKey(DbUtil.text(id))
        return pkKey in col["rows"]
    }

    fn count(db, collectionName, whereSpec) {
        if not self.hasCollection(db, collectionName) { return 0 }
        let col = self.ensureCollection(db, collectionName)
        if whereSpec == null or (type(whereSpec) == "dict" and len(whereSpec.keys()) == 0) {
            return len(col["order"])
        }
        return len(self.matchingRows(col, whereSpec))
    }

    # Uses secondary hash index when `whereSpec` has an exact equality on an indexed field.
    fn matchingRows(col, whereSpec) {
        let candidateKeys = col["order"]
        if whereSpec != null and type(whereSpec) == "dict" {
            let pkField = col["primaryKey"]
            if (pkField in whereSpec) and not DbQuery.isOperatorDict(whereSpec[pkField]) {
                let pkKey = DbUtil.safeKey(DbUtil.text(whereSpec[pkField]))
                candidateKeys = (pkKey in col["rows"]) ? [pkKey] : []
            } else {
                for k in whereSpec.keys() {
                    if k.startsWith("$") { continue }
                    let cond = whereSpec[k]
                    if not DbQuery.isOperatorDict(cond) and cond != null {
                        let fKey = DbUtil.safeKey(k)
                        if fKey in col["indexes"] {
                            let buckets = col["indexes"][fKey]["buckets"]
                            let vKey = DbUtil.safeKey(DbUtil.text(cond))
                            candidateKeys = (vKey in buckets) ? buckets[vKey] : []
                            break
                        }
                    }
                }
            }
        }

        let matched = []
        for pkKey in candidateKeys {
            let doc = col["rows"][pkKey]
            if DbQuery.matches(doc, whereSpec) {
                matched.push(DbUtil.clone(doc))
            }
        }
        return matched
    }

    # Executes a rich query against `collectionName`.
    # querySpec: {
    #   "where": {...}, "join": {...}, "groupBy": ..., "metrics": {...}, "having": {...},
    #   "orderBy" / "sort": ..., "offset": 0, "limit": 0, "select": [...]
    # }
    fn find(db, collectionName, querySpec) {
        DbUtil.liftStepLimit()
        if not self.hasCollection(db, collectionName) { return [] }
        let col = self.ensureCollection(db, collectionName)
        let q = querySpec != null ? querySpec : {}

        let whereSpec = q.get("where", null)
        # Allow passing a plain filter dict directly as querySpec when no reserved keys are present
        if whereSpec == null and not ("select" in q) and not ("orderBy" in q) and not ("sort" in q) and not ("limit" in q) and not ("offset" in q) and not ("join" in q) and not ("groupBy" in q) and not ("metrics" in q) {
            whereSpec = q
        }

        let hasJoin = "join" in q and q["join"] != null
        let rows = self.matchingRows(col, hasJoin ? null : whereSpec)

        # Optional JOIN
        if hasJoin {
            let jSpec = q["join"]
            let rightRows = []
            if "right" in jSpec and type(jSpec["right"]) == "array" {
                rightRows = jSpec["right"]
            } else if "table" in jSpec or "collection" in jSpec {
                let targetCol = jSpec.get("table", jSpec.get("collection", ""))
                rightRows = self.find(db, targetCol, {})
            }
            rows = DbQuery.executeJoin(rows, rightRows, jSpec)
            if whereSpec != null {
                let filtered = []
                for r in rows {
                    if DbQuery.matches(r, whereSpec) { filtered.push(r) }
                }
                rows = filtered
            }
        }

        # Optional GROUP BY / Metrics Aggregation
        if ("groupBy" in q and q["groupBy"] != null) or ("metrics" in q and q["metrics"] != null) {
            rows = DbQuery.aggregate(rows, {
                "groupBy": q.get("groupBy", []),
                "metrics": q.get("metrics", {"count": {"$count": "*"}}),
                "having": q.get("having", null)
            })
        }

        # Optional ORDER BY / sort
        let orderSpec = q.get("orderBy", q.get("sort", null))
        if orderSpec != null {
            rows = DbUtil.sortRecords(rows, orderSpec)
        }

        # Optional OFFSET & LIMIT
        let offset = q.get("offset", 0)
        if type(offset) == "number" and offset > 0 {
            if offset >= len(rows) { return [] }
            rows = rows.slice(offset)
        }
        let limit = q.get("limit", 0)
        if type(limit) == "number" and limit > 0 and len(rows) > limit {
            rows = rows.slice(0, limit)
        }

        # Optional SELECT projection
        if "select" in q and q["select"] != null {
            rows = DbQuery.project(rows, q["select"])
        }

        return rows
    }

    fn findOne(db, collectionName, whereSpec) {
        let hits = self.find(db, collectionName, {"where": whereSpec, "limit": 1})
        if len(hits) == 0 { return null }
        return hits[0]
    }

    fn update(db, collectionName, whereSpec, changes) {
        if not self.hasCollection(db, collectionName) { return 0 }
        let col = self.ensureCollection(db, collectionName)
        let pkField = col["primaryKey"]
        let updatedCount = 0

        for pkKey in col["order"] {
            let doc = col["rows"][pkKey]
            if DbQuery.matches(doc, whereSpec) {
                let updatedDoc = DbQuery.applyChanges(doc, changes)
                updatedDoc[pkField] = doc[pkField]
                DbSchema.assertValid(col["schema"], updatedDoc)
                self.checkUniqueConstraints(col, updatedDoc, pkKey)
                col["rows"][pkKey] = updatedDoc
                updatedCount += 1
            }
        }
        if updatedCount > 0 {
            self.rebuildAllIndexes(col)
        }
        return updatedCount
    }

    fn updateById(db, collectionName, id, changes) {
        if not self.hasCollection(db, collectionName) { return null }
        let col = self.ensureCollection(db, collectionName)
        let pkKey = DbUtil.safeKey(DbUtil.text(id))
        if not (pkKey in col["rows"]) { return null }
        let doc = col["rows"][pkKey]
        let pkField = col["primaryKey"]
        let updatedDoc = DbQuery.applyChanges(doc, changes)
        updatedDoc[pkField] = doc[pkField]
        DbSchema.assertValid(col["schema"], updatedDoc)
        self.checkUniqueConstraints(col, updatedDoc, pkKey)
        col["rows"][pkKey] = updatedDoc
        self.rebuildAllIndexes(col)
        return DbUtil.clone(updatedDoc)
    }

    fn upsert(db, collectionName, whereSpec, docOrChanges) {
        let existing = self.findOne(db, collectionName, whereSpec)
        if existing != null {
            let col = self.ensureCollection(db, collectionName)
            let pk = existing[col["primaryKey"]]
            return self.updateById(db, collectionName, pk, docOrChanges)
        }
        return self.insert(db, collectionName, docOrChanges)
    }

    fn remove(db, collectionName, whereSpec) {
        if not self.hasCollection(db, collectionName) { return 0 }
        let col = self.ensureCollection(db, collectionName)
        let keptOrder = []
        let keptRows = {}
        let removedCount = 0

        for pkKey in col["order"] {
            let doc = col["rows"][pkKey]
            if DbQuery.matches(doc, whereSpec) {
                removedCount += 1
            } else {
                keptOrder.push(pkKey)
                keptRows[pkKey] = doc
            }
        }
        if removedCount > 0 {
            col["order"] = keptOrder
            col["rows"] = keptRows
            self.rebuildAllIndexes(col)
        }
        return removedCount
    }

    fn removeById(db, collectionName, id) {
        if not self.hasCollection(db, collectionName) { return false }
        let col = self.ensureCollection(db, collectionName)
        let pkKey = DbUtil.safeKey(DbUtil.text(id))
        if not (pkKey in col["rows"]) { return false }
        let whereSpec = {}
        whereSpec[col["primaryKey"]] = col["rows"][pkKey][col["primaryKey"]]
        return self.remove(db, collectionName, whereSpec) > 0
    }

    fn clear(db, collectionName) {
        if not self.hasCollection(db, collectionName) { return 0 }
        let col = self.ensureCollection(db, collectionName)
        let n = len(col["order"])
        col["rows"] = {}
        col["order"] = []
        col["nextId"] = 1
        self.rebuildAllIndexes(col)
        return n
    }

    # â”€â”€ Transactions (Snapshot Isolation) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn begin(db) {
        let snap = DbUtil.clone(db["collections"])
        db["snapshots"].push(snap)
        return len(db["snapshots"])
    }

    fn commit(db) {
        let n = len(db["snapshots"])
        if n == 0 { raise "no active transaction to commit" }
        db["snapshots"].pop()
        return true
    }

    fn rollback(db) {
        let n = len(db["snapshots"])
        if n == 0 { raise "no active transaction to roll back" }
        let snap = db["snapshots"].pop()
        db["collections"] = snap
        return true
    }

    fn transaction(db, action) {
        self.begin(db)
        let result = null
        let err = ""
        try {
            result = action()
        } catch (e) {
            err = str(e)
        }
        if err != "" {
            self.rollback(db)
            raise err
        }
        self.commit(db)
        return result
    }

    # â”€â”€ SQL, CSV Import/Export, Persistence & Stats â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

    fn sql(db, sqlText) {
        return DbSql.execute(db, sqlText)
    }

    fn importCsv(db, collectionName, csvText, options) {
        let rows = DbFormat.parseCsv(csvText, options)
        return self.insertMany(db, collectionName, rows)
    }

    fn exportCsv(db, collectionName, querySpec) {
        let rows = self.find(db, collectionName, querySpec)
        return DbFormat.csv(rows, null)
    }

    fn stats(db) {
        let colStats = []
        let totalRows = 0
        for name in self.listCollections(db) {
            let col = self.ensureCollection(db, name)
            let count = len(col["order"])
            totalRows += count
            let idxNames = []
            for ik in col["indexes"].keys() {
                idxNames.push(col["indexes"][ik]["field"])
            }
            colStats.push({
                "name": name,
                "rowCount": count,
                "primaryKey": col["primaryKey"],
                "nextId": col["nextId"],
                "indexes": idxNames,
                "schemaFields": col["schema"].keys()
            })
        }
        return {
            "version": db.get("version", self.VERSION),
            "name": db.get("name", "quantum-db"),
            "collectionCount": len(colStats),
            "totalRows": totalRows,
            "collections": colStats
        }
    }

    fn toJSON(db) {
        let clean = {
            "version": db.get("version", self.VERSION),
            "name": db.get("name", "quantum-db"),
            "collections": db["collections"]
        }
        return JSON.stringify(clean)
    }

    fn fromJSON(jsonText) {
        let parsed = JSON.parse(jsonText)
        if type(parsed) != "dict" or not ("collections" in parsed) {
            raise "invalid quantum-db JSON file"
        }
        parsed["snapshots"] = []
        return parsed
    }

    fn save(db, filePath) {
        DbUtil.writeText(filePath, self.toJSON(db))
        return filePath
    }

    fn open(filePath) {
        if not os.path.exists(filePath) {
            return self.create({"name": DbUtil.fileOf(filePath)})
        }
        let raw = DbUtil.readText(filePath)
        return self.fromJSON(raw)
    }

    # Built-in sample relational/document database (`users`, `products`, `orders`)
    fn sampleDatabase() {
        let db = self.create({"name": "quantum-store"})
        self.createCollection(db, "users", {
            "primaryKey": "id",
            "unique": ["email"],
            "indexes": ["role", "city"],
            "schema": {
                "name": {"type": "string", "required": true, "minLength": 2},
                "email": {"type": "string", "required": true},
                "role": {"type": "string", "default": "member", "enum": ["admin", "engineer", "designer", "member"]},
                "age": {"type": "int", "min": 13, "max": 120},
                "city": {"type": "string", "default": "Lahore"}
            }
        })
        self.insertMany(db, "users", [
            {"id": 1, "name": "Ada Lovelace", "email": "ada@quantum.dev", "role": "admin", "age": 28, "city": "London"},
            {"id": 2, "name": "Bilal Raza", "email": "bilal@quantum.dev", "role": "engineer", "age": 24, "city": "Lahore"},
            {"id": 3, "name": "Grace Hopper", "email": "grace@quantum.dev", "role": "admin", "age": 35, "city": "New York"},
            {"id": 4, "name": "Alan Turing", "email": "alan@quantum.dev", "role": "engineer", "age": 31, "city": "London"},
            {"id": 5, "name": "Sara Khan", "email": "sara@quantum.dev", "role": "designer", "age": 26, "city": "Lahore"}
        ])

        self.createCollection(db, "orders", {
            "primaryKey": "id",
            "indexes": ["userId", "status"],
            "schema": {
                "userId": {"type": "int", "required": true},
                "item": {"type": "string", "required": true},
                "amount": {"type": "number", "min": 0},
                "status": {"type": "string", "default": "paid"}
            }
        })
        self.insertMany(db, "orders", [
            {"id": 101, "userId": 1, "item": "Quantum Pro License", "amount": 199.0, "status": "paid"},
            {"id": 102, "userId": 2, "item": "Cloud VM Cluster", "amount": 350.0, "status": "paid"},
            {"id": 103, "userId": 1, "item": "Edge Compiler Addon", "amount": 89.0, "status": "paid"},
            {"id": 104, "userId": 4, "item": "Quantum Pro License", "amount": 199.0, "status": "pending"},
            {"id": 105, "userId": 2, "item": "Static Site Hosting", "amount": 49.0, "status": "paid"}
        ])
        return db
    }
}

Db = __QDbEngine()

# ── module: ./harness.sa (test/harness.sa) ──
# quantum-db / test harness â€” zero-dependency assertion recorder
#
#   Check.section("DbQuery")
#   Check.eq("matches gt", DbQuery.matches({"age": 30}, {"age": {"$gt": 25}}), true)
#   Check.report()
#
# Exposes the global: Check

class __QDbCheck {
    fn init() {
        self.passed = 0
        self.failed = 0
        self.failures = []
        self.group = ""
    }

    fn section(name) {
        self.group = name
        print("")
        print(name)
    }

    fn pass(label) {
        self.passed += 1
        print("  ok   " + label)
    }

    fn failWith(label, detail) {
        self.failed += 1
        self.failures.push(self.group + " > " + label)
        print("  FAIL " + label)
        if detail != "" { print(detail) }
    }

    fn eq(label, actual, expected) {
        if DbUtil.equals(actual, expected) {
            self.pass(label)
        } else {
            self.failWith(label, "       expected: " + self.show(expected) + "\n       actual:   " + self.show(actual))
        }
    }

    fn ok(label, condition) {
        if condition {
            self.pass(label)
        } else {
            self.failWith(label, "")
        }
    }

    fn has(label, text, part) {
        if type(text) == "string" and text.contains(part) {
            self.pass(label)
        } else {
            self.failWith(label, "       expected to contain: " + self.show(part) + "\n       actual: " + self.show(text))
        }
    }

    fn lacks(label, text, part) {
        if type(text) == "string" and not text.contains(part) {
            self.pass(label)
        } else {
            self.failWith(label, "       expected NOT to contain: " + self.show(part))
        }
    }

    fn throws(label, action) {
        let threw = false
        try {
            action()
        } catch (e) {
            threw = true
        }
        self.ok(label, threw)
    }

    fn show(v) {
        if type(v) == "string" { return "\"" + v.replaceAll("\n", "\\n") + "\"" }
        if v == null { return "null" }
        return str(v)
    }

    fn report() {
        print("")
        let total = self.passed + self.failed
        if self.failed == 0 {
            print("PASS " + str(self.passed) + " passed, 0 failed, " + str(total) + " total")
            return
        }
        print("FAIL " + str(self.passed) + " passed, " + str(self.failed) + " failed, " + str(total) + " total")
        for f in self.failures { print("  - " + f) }
        raise str(self.failed) + " test(s) failed"
    }
}

Check = __QDbCheck()

# ── entry: test/all.test.sa ──
# quantum-db â€” full test suite
#
#   qrun test/run-tests.sa


# â”€â”€ 1. DbUtil â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

Check.section("DbUtil")
Check.eq("text from null", DbUtil.text(null), "")
Check.eq("text from bool", DbUtil.text(true), "true")
Check.eq("text from int", DbUtil.text(105), "105")
Check.eq("safeKey protects 'get'", DbUtil.safeKey("get"), "_get")
Check.eq("unsafeKey restores 'get'", DbUtil.unsafeKey("_get"), "get")
Check.eq("safeKey leaves normal string", DbUtil.safeKey("users"), "users")

Check.ok("isNumericString integer", DbUtil.isNumericString("-42"))
Check.ok("isNumericString float", DbUtil.isNumericString("19.95"))
Check.ok("isNumericString rejects two dots", not DbUtil.isNumericString("1.2.3"))
Check.eq("autoValue int", DbUtil.autoValue("42"), 42)
Check.eq("autoValue bool", DbUtil.autoValue("true"), true)
Check.eq("autoValue null", DbUtil.autoValue("NULL"), null)
Check.eq("autoValue string", DbUtil.autoValue("hello"), "hello")

let nested = {"user": {"profile": {"city": "Lahore", "zip": 54000}}}
let copyNested = DbUtil.clone(nested)
DbUtil.setPath(copyNested, "user.profile.city", "Karachi")
Check.eq("deep clone does not mutate original", DbUtil.getPath(nested, "user.profile.city"), "Lahore")
Check.eq("setPath updates nested value", DbUtil.getPath(copyNested, "user.profile.city"), "Karachi")
Check.ok("hasPath true for existing", DbUtil.hasPath(nested, "user.profile.zip"))
Check.ok("hasPath false for missing", not DbUtil.hasPath(nested, "user.profile.country"))

let toSort = [
    {"name": "Charlie", "dept": "eng", "score": 80},
    {"name": "Alice", "dept": "eng", "score": 95},
    {"name": "Bob", "dept": "design", "score": 95}
]
let sortedMulti = DbUtil.sortRecords(toSort, ["score:desc", "name:asc"])
Check.eq("multi-key sort 1st", sortedMulti[0]["name"], "Alice")
Check.eq("multi-key sort 2nd", sortedMulti[1]["name"], "Bob")
Check.eq("multi-key sort 3rd", sortedMulti[2]["name"], "Charlie")

# â”€â”€ 2. DbSchema â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

Check.section("DbSchema")
let userSchema = DbSchema.normalize({
    "name": "string!",
    "age": {"type": "int", "min": 13, "max": 120},
    "role": {"type": "string", "default": "member", "enum": ["admin", "member", "guest"]},
    "tags": {"type": "array", "maxLength": 3}
})

let prepared = DbSchema.prepare(userSchema, {"name": "Bilal", "age": 24})
Check.eq("prepare fills default role", prepared["role"], "member")
Check.ok("validate passes valid doc", DbSchema.validate(userSchema, prepared)["valid"])

let missingReq = DbSchema.validate(userSchema, {"age": 25})
Check.ok("validate catches missing required field", not missingReq["valid"])

let badType = DbSchema.validate(userSchema, {"name": "Ada", "age": 22.5})
Check.ok("validate catches non-int float for int field", not badType["valid"])

let badMin = DbSchema.validate(userSchema, {"name": "Kid", "age": 8})
Check.ok("validate catches min constraint", not badMin["valid"])

let badEnum = DbSchema.validate(userSchema, {"name": "Ada", "age": 28, "role": "superadmin"})
Check.ok("validate catches enum constraint", not badEnum["valid"])

# â”€â”€ 3. DbQuery (Filters, Updates, Joins, Aggregations) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

Check.section("DbQuery")
let sampleDoc = {
    "id": 1,
    "name": "Ada Lovelace",
    "age": 28,
    "role": "admin",
    "skills": ["quantum", "math", "vm"],
    "address": {"city": "London", "country": "UK"}
}

Check.ok("matches direct equality", DbQuery.matches(sampleDoc, {"role": "admin"}))
Check.ok("matches nested dotted path", DbQuery.matches(sampleDoc, {"address.city": "London"}))
Check.ok("matches $gt and $lte", DbQuery.matches(sampleDoc, {"age": {"$gt": 20, "$lte": 28}}))
Check.ok("matches $between", DbQuery.matches(sampleDoc, {"age": {"$between": [25, 30]}}))
Check.ok("matches $in", DbQuery.matches(sampleDoc, {"role": {"$in": ["admin", "lead"]}}))
Check.ok("matches $nin", DbQuery.matches(sampleDoc, {"role": {"$nin": ["guest", "banned"]}}))
Check.ok("matches array $contains", DbQuery.matches(sampleDoc, {"skills": {"$contains": "quantum"}}))
Check.ok("matches array $all", DbQuery.matches(sampleDoc, {"skills": {"$all": ["quantum", "vm"]}}))
Check.ok("matches array $size", DbQuery.matches(sampleDoc, {"skills": {"$size": 3}}))
Check.ok("matches string $startsWith", DbQuery.matches(sampleDoc, {"name": {"$startsWith": "Ada"}}))
Check.ok("matches string $like", DbQuery.matches(sampleDoc, {"name": {"$like": "Ada %lace"}}))
Check.ok("matches string $ilike", DbQuery.matches(sampleDoc, {"name": {"$ilike": "ada %LACE"}}))
Check.ok("matches $or", DbQuery.matches(sampleDoc, {"$or": [{"age": 99}, {"role": "admin"}]}))
Check.ok("matches $not", DbQuery.matches(sampleDoc, {"$not": {"role": "guest"}}))

let mutated = DbQuery.applyChanges(sampleDoc, {
    "$set": {"role": "lead", "address.city": "Oxford"},
    "$inc": {"age": 2},
    "$push": {"skills": "sql"},
    "$pull": {"skills": "math"}
})
Check.eq("$set updates top & nested field", [mutated["role"], DbUtil.getPath(mutated, "address.city")], ["lead", "Oxford"])
Check.eq("$inc increments age", mutated["age"], 30)
Check.eq("$push and $pull update array", mutated["skills"], ["quantum", "vm", "sql"])

let projected = DbQuery.projectRecord(sampleDoc, ["name", {"field": "address.city", "as": "city"}])
Check.eq("projectRecord keeps & aliases fields", projected, {"name": "Ada Lovelace", "city": "London"})

# â”€â”€ 4. DbFormat (ASCII Table, Markdown, CSV, JSONL) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

Check.section("DbFormat")
let fmtRows = [
    {"id": 1, "name": "Ada, Countess", "score": 98.5, "active": true},
    {"id": 2, "name": "Bilal \"Dev\"", "score": 92.0, "active": false}
]
let asciiTbl = DbFormat.table(fmtRows, ["id", "name", "score"])
Check.has("ASCII table has border", asciiTbl, "+----+")
Check.has("ASCII table has header", asciiTbl, "| id |")

let mdTbl = DbFormat.markdown(fmtRows, ["id", "name", "score"])
Check.has("Markdown table has header", mdTbl, "| id | name | score |")
Check.has("Markdown table has separator", mdTbl, "| --- | --- | --- |")

let csvOut = DbFormat.csv(fmtRows, ["id", "name", "score", "active"])
let csvBack = DbFormat.parseCsv(csvOut, {"autoTypes": true})
Check.eq("CSV round-trip count", len(csvBack), 2)
Check.eq("CSV round-trip preserves comma in string", csvBack[0]["name"], "Ada, Countess")
Check.eq("CSV round-trip preserves quotes in string", csvBack[1]["name"], "Bilal \"Dev\"")
Check.eq("CSV round-trip auto-converts number & bool", [csvBack[0]["score"], csvBack[0]["active"]], [98.5, true])

let jsonlOut = DbFormat.jsonl(fmtRows)
let jsonlBack = DbFormat.parseJsonl(jsonlOut)
Check.eq("JSONL round-trip", jsonlBack, fmtRows)

# â”€â”€ 5. Db Engine (CRUD, Indexes, Joins, Aggregations, Transactions) â”€â”€â”€â”€â”€â”€

Check.section("Db Engine")
let db = Db.sampleDatabase()
Check.eq("sampleDatabase has 5 users", Db.count(db, "users", null), 5)
Check.eq("sampleDatabase has 5 orders", Db.count(db, "orders", null), 5)

let insertedUser = Db.insert(db, "users", {"name": "Zayd Ali", "email": "zayd@quantum.dev"})
Check.eq("auto-increment assigns id 6", insertedUser["id"], 6)
Check.eq("schema default sets role='member'", insertedUser["role"], "member")
Check.eq("schema default sets city='Lahore'", insertedUser["city"], "Lahore")

Check.throws("unique index rejects duplicate email", fn() {
    Db.insert(db, "users", {"name": "Clone", "email": "ada@quantum.dev", "age": 30})
})

Check.throws("primary key rejects duplicate id", fn() {
    Db.insert(db, "users", {"id": 1, "name": "Clone", "email": "clone@quantum.dev", "age": 30})
})

# Indexed equality lookup
let lahoreUsers = Db.find(db, "users", {"where": {"city": "Lahore"}, "orderBy": "id:asc"})
Check.eq("indexed lookup finds 3 Lahore users", len(lahoreUsers), 3)
Check.eq("indexed lookup first is Bilal", lahoreUsers[0]["name"], "Bilal Raza")

# Update & Upsert
let updCount = Db.update(db, "users", {"email": "zayd@quantum.dev"}, {"$set": {"age": 27, "role": "engineer"}})
Check.eq("update returns 1 modified row", updCount, 1)
Check.eq("updated age persisted", Db.get(db, "users", 6)["age"], 27)

let upsertedNew = Db.upsert(db, "users", {"email": "noor@quantum.dev"}, {"name": "Noor", "email": "noor@quantum.dev", "age": 23})
Check.eq("upsert inserts when missing", upsertedNew["id"], 7)
let upsertedExisting = Db.upsert(db, "users", {"email": "noor@quantum.dev"}, {"$set": {"age": 24}})
Check.eq("upsert updates when present", upsertedExisting["age"], 24)

# Lookup Join & GroupBy via Db.find
let userWithOrders = Db.find(db, "users", {
    "where": {"id": 1},
    "join": {"table": "orders", "localField": "id", "foreignField": "userId", "type": "lookup", "as": "orders"}
})
Check.eq("lookup join attaches 2 orders to Ada", len(userWithOrders[0]["orders"]), 2)

let spendByUser = Db.find(db, "orders", {
    "where": {"status": "paid"},
    "groupBy": "userId",
    "metrics": {"orderCount": {"$count": "*"}, "totalSpent": {"$sum": "amount"}},
    "orderBy": "totalSpent:desc"
})
Check.eq("aggregation top spender is userId 2", spendByUser[0]["userId"], 2)
Check.eq("aggregation top spender sum is 399", spendByUser[0]["totalSpent"], 399.0)

# Transactions (commit & rollback)
Db.begin(db)
Db.remove(db, "users", {"city": "Lahore"})
Check.eq("inside tx Lahore users removed", Db.count(db, "users", {"city": "Lahore"}), 0)
Db.rollback(db)
Check.eq("after rollback Lahore users restored", Db.count(db, "users", {"city": "Lahore"}), 4)

Check.throws("failed Db.transaction rolls back automatically", fn() {
    Db.transaction(db, fn() {
        Db.removeById(db, "users", 1)
        raise "abort transaction"
    })
})
Check.ok("user 1 still exists after failed transaction", Db.has(db, "users", 1))

# â”€â”€ 6. DbSql (CREATE, INSERT, SELECT, JOIN, GROUP BY, UPDATE, DELETE, DROP) â”€â”€

Check.section("DbSql")
Db.sql(db, "CREATE TABLE tasks (id INT PRIMARY KEY, title STRING REQUIRED, points INT DEFAULT 10, done BOOL DEFAULT false)")
Check.ok("CREATE TABLE creates collection", Db.hasCollection(db, "tasks"))

let insRes = Db.sql(db, "INSERT INTO tasks (title, points, done) VALUES ('Write parser', 25, true), ('Write tests', 15, false), ('Publish package', 50, false)")
Check.eq("SQL INSERT adds 3 rows", insRes["insertedCount"], 3)

let selRows = Db.sql(db, "SELECT id, title, points FROM tasks WHERE points >= 20 AND done = false ORDER BY points DESC")
Check.eq("SQL SELECT WHERE filters to 1 row", len(selRows), 1)
Check.eq("SQL SELECT row title", selRows[0]["title"], "Publish package")

let likeRows = Db.sql(db, "SELECT title FROM tasks WHERE title LIKE 'Write %' ORDER BY id ASC")
Check.eq("SQL LIKE matches 2 rows", len(likeRows), 2)

let inRows = Db.sql(db, "SELECT name FROM users WHERE role IN ('admin', 'designer') ORDER BY name ASC")
Check.eq("SQL IN matches 3 users", len(inRows), 3)

let aggSql = Db.sql(db, "SELECT done, COUNT(*) AS count, SUM(points) AS total_points FROM tasks GROUP BY done ORDER BY total_points DESC")
Check.eq("SQL GROUP BY returns 2 groups", len(aggSql), 2)
Check.eq("SQL GROUP BY top total_points is 65", aggSql[0]["total_points"], 65)

let joinSql = Db.sql(db, "SELECT name, item, amount FROM users INNER JOIN orders ON users.id = orders.userId WHERE amount >= 150 ORDER BY amount DESC")
Check.eq("SQL INNER JOIN with WHERE returns 3 rows", len(joinSql), 3)
Check.eq("SQL INNER JOIN top row is Bilal Raza ($350)", [joinSql[0]["name"], joinSql[0]["amount"]], ["Bilal Raza", 350.0])

let updSql = Db.sql(db, "UPDATE tasks SET done = true, points = 30 WHERE title = 'Write tests'")
Check.eq("SQL UPDATE modifies 1 row", updSql["updatedCount"], 1)
Check.eq("SQL UPDATE persisted values", [Db.get(db, "tasks", 2)["done"], Db.get(db, "tasks", 2)["points"]], [true, 30])

let delSql = Db.sql(db, "DELETE FROM tasks WHERE done = true")
Check.eq("SQL DELETE removes 2 done tasks", delSql["deletedCount"], 2)
Check.eq("1 task remains after DELETE", Db.count(db, "tasks", null), 1)

let dropSql = Db.sql(db, "DROP TABLE tasks")
Check.ok("SQL DROP TABLE removes collection", dropSql["dropped"] and not Db.hasCollection(db, "tasks"))

# JSON Serialization round-trip
let serialized = Db.toJSON(db)
let reloaded = Db.fromJSON(serialized)
Check.eq("JSON round-trip preserves user count", Db.count(reloaded, "users", null), 7)
Check.eq("JSON round-trip preserves SQL query ability", len(Db.sql(reloaded, "SELECT id FROM users WHERE role = 'admin'")), 2)

Check.report()
